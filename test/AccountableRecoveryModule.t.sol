pragma solidity ^0.8.28;

import {Test, console} from "forge-std/Test.sol";
import {AccountableRecoveryModule} from "../src/AccountableRecoveryModule.sol";
import {MockAccount} from "../src/mocks/MockAccount.sol";
import {OwnerValidator} from "../src/mocks/OwnerValidator.sol";

/// @notice Replays the scenario generated by `akr fixtures` (offchain/) against the module: the
///         guardians, the combiner and the auditor run off-chain with blst, and the module must
///         accept or reject each transaction exactly as the off-chain Judge predicts.
contract AccountableRecoveryModuleTest is Test {
    // indices of the steps in the fixture
    uint256 constant INSTALL = 0;
    uint256 constant REQUEST = 1;
    uint256 constant CANCEL = 2;
    uint256 constant REQUEST_E1 = 3;
    uint256 constant DISPUTE_COMPLIANT = 4;
    uint256 constant FINALIZE = 5;
    uint256 constant ADVANCE = 6;
    uint256 constant UPDATE_KEY = 7;
    uint256 constant REQUEST_POLICY = 8;
    uint256 constant DISPUTE_POLICY = 9;
    uint256 constant REQUEST_BAD = 10;
    uint256 constant DISPUTE_BAD = 11;
    uint256 constant NUM_STEPS = 12;

    string json;
    AccountableRecoveryModule module;
    MockAccount account;
    uint256 delta;

    function setUp() public {
        json = vm.readFile(string.concat(vm.projectRoot(), "/fixtures/scenario_n7.json"));
        delta = vm.parseJsonUint(json, ".delta");
        address moduleAddr = vm.parseJsonAddress(json, ".module");
        address validatorAddr = vm.parseJsonAddress(json, ".validator");
        address accountAddr = vm.parseJsonAddress(json, ".account");
        address owner = vm.parseJsonAddress(json, ".owner");
        deployCodeTo("AccountableRecoveryModule.sol:AccountableRecoveryModule", moduleAddr);
        deployCodeTo("OwnerValidator.sol:OwnerValidator", validatorAddr);
        deployCodeTo("MockAccount.sol:MockAccount", abi.encode(validatorAddr, owner), accountAddr);
        module = AccountableRecoveryModule(moduleAddr);
        account = MockAccount(accountAddr);
        vm.roll(100);
    }

    function _key(uint256 i, string memory field) internal pure returns (string memory) {
        return string.concat(".steps[", vm.toString(i), "].", field);
    }

    function _data(uint256 i) internal view returns (bytes memory) {
        return vm.parseJsonBytes(json, _key(i, "data"));
    }

    function _send(uint256 i) internal returns (bool ok, uint256 gasUsed) {
        bool toAccount = vm.parseJsonBool(json, _key(i, "toAccount"));
        uint256 mine = vm.parseJsonUint(json, _key(i, "mineBefore"));
        if (mine > 0) vm.roll(block.number + mine);
        vm.roll(block.number + 1);
        address to = toAccount ? address(account) : address(module);
        bytes memory data = _data(i);
        uint256 g = gasleft();
        (ok,) = to.call(data);
        gasUsed = g - gasleft();
    }

    function _run(uint256 from, uint256 to) internal {
        for (uint256 i = from; i < to; ++i) {
            bool expected = vm.parseJsonBool(json, _key(i, "expectSuccess"));
            (bool ok, uint256 g) = _send(i);
            assertEq(ok, expected, vm.parseJsonString(json, _key(i, "name")));
            if (ok) console.log(vm.parseJsonString(json, _key(i, "name")), g);
        }
    }

    function _epoch() internal view returns (uint64) {
        return module.getConfig(address(account)).epoch;
    }

    // ------------------------------------------------------------------

    function test_fullScenario() public {
        address newOwner = vm.parseJsonAddress(json, ".newOwner");
        _run(0, REQUEST);
        assertTrue(module.isInitialized(address(account)));

        _run(REQUEST, CANCEL);
        assertEq(module.getConfig(address(account)).pendOwner, newOwner);
        _run(CANCEL, REQUEST_E1);
        assertEq(_epoch(), 1);
        assertEq(module.getConfig(address(account)).pendRound, 0);

        _run(REQUEST_E1, ADVANCE);
        assertEq(account.owner(), newOwner, "owner key replaced by Finalize");
        assertEq(_epoch(), 2);

        _run(ADVANCE, UPDATE_KEY);
        assertEq(_epoch(), 3);
        bytes32 epkHash = module.getConfig(address(account)).epkHash;
        _run(UPDATE_KEY, REQUEST_POLICY);
        assertEq(_epoch(), 4);
        assertTrue(module.getConfig(address(account)).epkHash != epkHash);

        // a request whose evidence set violates the policy (it contains neither guardian 1 nor 2)
        _run(REQUEST_POLICY, DISPUTE_POLICY);
        vm.expectEmit(true, false, false, true, address(module));
        emit AccountableRecoveryModule.Disputed(address(account), 4, false, 0x3c); // S = {3, 4, 5, 6}
        _run(DISPUTE_POLICY, REQUEST_BAD);
        assertEq(_epoch(), 5);

        // a request with a forged evidence signature
        _run(REQUEST_BAD, DISPUTE_BAD);
        vm.expectEmit(true, false, false, true, address(module));
        emit AccountableRecoveryModule.Disputed(address(account), 5, true, 0);
        _run(DISPUTE_BAD, NUM_STEPS);
        assertEq(_epoch(), 6);
        assertEq(module.getConfig(address(account)).pendRound, 0);
    }

    function test_approvalIsBoundToEpoch() public {
        _run(0, REQUEST_E1); // request and cancel in epoch 0
        (bool ok,) = _send(REQUEST); // replay the approval of epoch 0 in epoch 1
        assertFalse(ok);
    }

    function test_rejectsTamperedApproval() public {
        _run(0, REQUEST);
        bytes memory data = _data(REQUEST);
        // The calldata ends with the encoding of ct.c; flip one byte of c in the middle.
        data[data.length - 600] ^= 0x01;
        vm.roll(block.number + 1);
        (bool ok,) = address(module).call(data);
        assertFalse(ok);
    }

    function test_onlyOnePendingRequest() public {
        _run(0, CANCEL);
        (bool ok,) = _send(REQUEST);
        assertFalse(ok);
    }

    function test_finalizeOnlyAfterWindow() public {
        _run(0, CANCEL);
        _run(CANCEL, REQUEST_E1);
        _run(REQUEST_E1, DISPUTE_COMPLIANT);
        vm.roll(block.number + delta - 1);
        vm.expectRevert(AccountableRecoveryModule.WindowOpen.selector);
        module.finalize(address(account));
        vm.roll(block.number + 1);
        module.finalize(address(account));
    }

    function test_cancelOnlyDuringWindow() public {
        _run(0, CANCEL);
        vm.roll(block.number + delta);
        (bool ok,) = _send(CANCEL);
        assertFalse(ok);
    }

    function test_disputeOnlyDuringWindow() public {
        _run(0, DISPUTE_POLICY);
        vm.roll(block.number + delta);
        (bool ok,) = _send(DISPUTE_POLICY);
        assertFalse(ok);
    }

    function test_disputeOfCompliantRequestFails() public {
        _run(0, DISPUTE_COMPLIANT);
        vm.roll(block.number + 1);
        vm.expectRevert(AccountableRecoveryModule.NoViolation.selector);
        (bool ok,) = address(module).call(_data(DISPUTE_COMPLIANT));
        ok;
    }

    function test_advanceAndUpdateNeedNoPendingRequest() public {
        _run(0, ADVANCE);
        // put a request in epoch 2 is not possible with the fixture; instead replaying Advance in
        // epoch 3 must fail because the signature names epoch 2.
        _run(ADVANCE, UPDATE_KEY);
        (bool ok,) = _send(ADVANCE);
        assertFalse(ok);
    }

    function test_isExecutorModule() public view {
        assertTrue(module.isModuleType(2));
        assertFalse(module.isModuleType(1));
    }
}
